# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Akun Administrator pertama (hanya dipakai saat NODE_ENV=production dan tabel users masih kosong).
# Data/akun demo TIDAK dimuat di produksi. Hapus ADMIN_PASSWORD setelah login pertama & ganti password.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="GANTI_DENGAN_PASSWORD_KUAT"
ADMIN_NAMA="Administrator"

# Set "true" untuk memaksa memuat data demo (JANGAN di server sungguhan).
SEED_DEMO_DATA="false"

# Set "1" jika server berada di balik reverse proxy (mis. Cloud Run / Nginx) agar
# rate limit login memakai IP klien asli.
TRUST_PROXY=""

# Pilih basis data: "sqlite" (default, tidak butuh server database terpisah)
# atau "mysql" (butuh server MySQL/MariaDB sungguhan, lihat variabel MYSQL_*
# di bawah). Keduanya didukung penuh — pilih sesuai infrastruktur sekolah.
DB_DRIVER="sqlite"

# --- Hanya dipakai kalau DB_DRIVER="sqlite" ---
# Lokasi file database SQLite (arahkan ke persistent volume di produksi).
DB_PATH=""

# --- Hanya dipakai kalau DB_DRIVER="mysql" ---
# Kredensial server MySQL/MariaDB. Database (MYSQL_DATABASE) harus sudah ada
# sebelum server pertama kali dijalankan; skema tabel dibuat otomatis oleh
# server/db.ts. Backup otomatis lewat mysqldump butuh binary "mysqldump" atau
# "mariadb-dump" tersedia di PATH server.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="absensi"
MYSQL_PASSWORD=""
MYSQL_DATABASE="absensi_siswa"
# Set "true" kalau server MySQL mewajibkan koneksi TLS.
MYSQL_SSL="false"

# Lokasi folder snapshot backup database (default: <DB_PATH>/../backups).
# Backup otomatis berjalan tiap 24 jam — VACUUM INTO untuk SQLite (file
# .sqlite3), atau mysqldump untuk MySQL (file .sql) — masa retensi mengikuti
# school_settings.backup_retention_weeks (diatur Administrator lewat aplikasi,
# default 8 minggu). WAJIB diarahkan ke persistent volume yang SAMA/TERPISAH
# dari DB_PATH di produksi — kalau tidak, backup ikut hilang saat instance
# di-recycle bersama data aslinya.
BACKUP_DIR=""
